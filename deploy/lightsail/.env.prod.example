APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

POSTGRES_DB=rfq_platform
POSTGRES_USER=rfq
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://rfq:change-this-password@postgres:5432/rfq_platform

API_BASE_URL=http://api:4000
PUBLIC_API_BASE_URL=https://api.example.com
APP_WEB_BASE_URL=https://app.example.com
AUTH_JWT_SECRET=replace-with-a-long-random-secret
ALLOW_LEGACY_PASSWORD_UPGRADE=false

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithAStrongPassword123!
BOOTSTRAP_ADMIN_NAME=Platform Admin

STORAGE_ENDPOINT=s3.eu-central-1.amazonaws.com
STORAGE_PORT=443
STORAGE_USE_SSL=true
STORAGE_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
STORAGE_SECRET_KEY=replace-with-aws-secret
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=rfq-attachments-prod

# ── Sentry / GlitchTip + Telegram alerts ─────────────────────────────
# Each project gets its own DSN — find them in GlitchTip:
#   Settings → Projects → [project] → Client Keys (DSN)
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_ENVIRONMENT=production

# Telegram bot — receives forwarded GlitchTip alerts
# 1) Create bot via @BotFather, then /newbot, save the token
# 2) Get your chat_id via @userinfobot (after messaging your bot once)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret for the GlitchTip → API webhook URL — any random string.
# In GlitchTip, configure the alert webhook URL as:
#   https://api.example.com/api/notifications/glitchtip?token=THE_SECRET
GLITCHTIP_WEBHOOK_SECRET=
