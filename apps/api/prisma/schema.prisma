generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LONDON_SALES
  ISTANBUL_PRICING
  ISTANBUL_MANAGER
  ADMIN
}

enum RfqStatus {
  NEW
  IN_REVIEW
  PRICING_IN_PROGRESS
  PENDING_MANAGER_APPROVAL
  QUOTED
  REVISION_REQUESTED
  WON
  LOST
  CLOSED
}

enum QuoteRevisionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// ── CRM (Faz A) ────────────────────────────────────────────────────
enum ProjectStage {
  IDENTIFIED // ham/dış-kaynak triyaj kutusu
  CONTACTED
  ENGAGED
  TENDER // RFQ'ya döndü, fiyat veriliyor
  WON
  LOST
}

enum ProjectSource {
  MANUAL
  BARBOUR
  REFERRAL
  REPEAT_CLIENT
  OTHER
}

enum ProjectCategory {
  JOINERY
  FFE
  FIT_OUT
  KITCHEN
  BAR_RESTAURANT
  RECEPTION
  BEDROOM_CASEGOODS
  RETAIL
  OTHER
}

// Bir firmanın projedeki rolü (ve varsayılan firma kategorisi)
enum CompanyRole {
  CLIENT_EMPLOYER
  MAIN_CONTRACTOR
  ARCHITECT
  QS_COST_CONSULTANT
  INTERIOR_DESIGNER
  SUBCONTRACTOR
  DEVELOPER
  OTHER
}

enum LossReason {
  PRICE
  TIMELINE
  LOST_TO_COMPETITOR
  CANCELLED
  NO_BUDGET
  OTHER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  fullName     String
  passwordHash String?
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rfqsCreated         Rfq[]                @relation("rfq_created_by")
  quoteRevisions      QuoteRevision[]      @relation("quote_created_by")
  approvals           QuoteApproval[]      @relation("approval_decided_by")
  attachmentUploads   Attachment[]         @relation("attachment_uploaded_by")
  rfqsAssignedPricing Rfq[]                @relation("rfq_assigned_pricing_user")
  rfqsAssignedBy      Rfq[]                @relation("rfq_assigned_by_user")
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  notifications       Notification[]       @relation("notification_recipient")
  comments            Comment[]            @relation("comment_author")
  rfqRevisions        RfqRevision[]        @relation("rfq_revision_changed_by")
  followUpsPerformed  FollowUpActivity[]   @relation("follow_up_performed_by")
  // CRM (Faz A)
  projectsOwned       Project[]            @relation("project_owner")
}

model Rfq {
  id             String    @id @default(uuid())
  projectName    String
  deadline       DateTime
  projectDetails String
  requestedBy    String
  status         RfqStatus @default(NEW)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Faz 3: Deal outcome tracking (WON/LOST)
  wonAt      DateTime?
  lostAt     DateTime?
  lostReason String?

  // Faz 3 — Feature 3: Customer-activity tracking for stall detection.
  // Set when the quote is approved (considered "sent to customer"), and
  // refreshed every time someone logs a follow-up. Used by the daily
  // stall-detection cron to find RFQs sitting silent too long.
  lastCustomerActivityAt DateTime?

  createdById           String
  createdBy             User      @relation("rfq_created_by", fields: [createdById], references: [id])
  assignedPricingUserId String?
  assignedPricingUser   User?     @relation("rfq_assigned_pricing_user", fields: [assignedPricingUserId], references: [id])
  assignedById          String?
  assignedBy            User?     @relation("rfq_assigned_by_user", fields: [assignedById], references: [id])
  assignedAt            DateTime?

  companyId String?
  company   CustomerCompany? @relation(fields: [companyId], references: [id])
  contactId String?
  contact   Contact?         @relation(fields: [contactId], references: [id])

  // CRM (Faz A): hangi projeye ait (1 proje → çok RFQ)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  attachments        Attachment[]
  quoteRevisions     QuoteRevision[]
  notifications      Notification[]
  comments           Comment[]
  revisions          RfqRevision[]
  followUpActivities FollowUpActivity[]

  @@index([createdById])
  @@index([assignedPricingUserId])
  @@index([status])
  @@index([companyId])
  @@index([projectId])
  // Faz 3 — Feature 3: Efficient stall-detection scans by
  // (status, lastCustomerActivityAt) so the cron stays cheap as
  // the RFQ table grows.
  @@index([status, lastCustomerActivityAt])
}

// Faz 3 — Feature 3: Manual follow-up events that sales logs after
// chasing the customer. Resets lastCustomerActivityAt and shows up
// on the RFQ timeline.
model FollowUpActivity {
  id            String   @id @default(uuid())
  rfqId         String
  rfq           Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  performedById String
  performedBy   User     @relation("follow_up_performed_by", fields: [performedById], references: [id])
  note          String?
  performedAt   DateTime @default(now())

  @@index([rfqId, performedAt])
}

// Faz 3 — Feature 2: Snapshot of an RFQ's editable fields at a point in time.
// Written by rfqStore.reviseRequest before the current Rfq row is updated.
// Each snapshot captures who changed it and why (changeReason required).
// Attachments uploaded as part of a revision can link to the corresponding
// RfqRevision.id so old specs stay bound to the revision they came with.
model RfqRevision {
  id    String @id @default(uuid())
  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  revisionNumber Int
  changeReason   String // min 10 chars enforced at the API layer

  // Snapshot of the editable RFQ fields at the time of this revision.
  projectName    String
  deadline       DateTime
  projectDetails String
  requestedBy    String
  companyId      String?
  contactId      String?

  changedById String
  changedBy   User     @relation("rfq_revision_changed_by", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  attachments    Attachment[]
  quoteRevisions QuoteRevision[] @relation("quote_to_rfq_revision")

  @@unique([rfqId, revisionNumber])
  @@index([rfqId, revisionNumber])
}

model QuoteRevision {
  id            String              @id @default(uuid())
  versionNumber Int
  currency      String
  totalAmount   Decimal             @db.Decimal(18, 2)
  notes         String
  status        QuoteRevisionStatus @default(DRAFT)
  createdAt     DateTime            @default(now())

  // Faz 3 — Feature 2: explains why this revision was issued.
  // Required for any revision after v1 (API layer enforces).
  changeReason String?

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id])

  // Optional link to the specific RfqRevision this quote was priced against.
  // Pricing team sets this manually; defaults to the current RFQ state.
  rfqRevisionId String?
  rfqRevision   RfqRevision? @relation("quote_to_rfq_revision", fields: [rfqRevisionId], references: [id])

  createdById String
  createdBy   User   @relation("quote_created_by", fields: [createdById], references: [id])

  attachments Attachment[]
  approvals   QuoteApproval[]

  @@unique([rfqId, versionNumber])
  @@index([rfqId])
  @@index([rfqRevisionId])
}

model QuoteApproval {
  id        String           @id @default(uuid())
  decision  ApprovalDecision
  comment   String
  decidedAt DateTime         @default(now())

  quoteRevisionId String
  quoteRevision   QuoteRevision @relation(fields: [quoteRevisionId], references: [id])

  decidedById String
  decidedBy   User   @relation("approval_decided_by", fields: [decidedById], references: [id])
}

model Attachment {
  id         String   @id @default(uuid())
  category   String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  publicUrl  String
  createdAt  DateTime @default(now())

  rfqId String?
  rfq   Rfq?    @relation(fields: [rfqId], references: [id])

  quoteRevisionId String?
  quoteRevision   QuoteRevision? @relation(fields: [quoteRevisionId], references: [id])

  // Faz 3 — Feature 2: binds an attachment to the RFQ revision it came in with.
  // When an architect sends a revised spec PDF, pricing uploads it against
  // the new revision, leaving the previous spec attached to the previous revision.
  rfqRevisionId String?
  rfqRevision   RfqRevision? @relation(fields: [rfqRevisionId], references: [id])

  // CRM (Faz A): project-level (tender/drawing/site photo, pre-RFQ) or
  // company-level (contract, profile) files.
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id])
  companyId String?
  company   CustomerCompany? @relation(fields: [companyId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("attachment_uploaded_by", fields: [uploadedById], references: [id])

  @@index([rfqId])
  @@index([projectId])
  @@index([companyId])
  @@index([quoteRevisionId])
  @@index([rfqRevisionId])
}

model CustomerCompany {
  id          String       @id @default(uuid())
  name        String
  sector      String?
  country     String?
  city        String?
  website     String?
  notes       String?
  // CRM (Faz A): default classification (per-project role lives on ProjectCompany)
  category    CompanyRole?
  addressLine String?
  postcode    String?
  phone       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  contacts     Contact[]
  rfqs         Rfq[]
  projectRoles ProjectCompany[]
  attachments  Attachment[]
}

model Contact {
  id        String   @id @default(uuid())
  fullName  String
  email     String?
  phone     String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId    String
  company      CustomerCompany  @relation(fields: [companyId], references: [id])
  rfqs         Rfq[]
  projectLinks ProjectContact[]

  @@index([companyId])
}

// ── CRM (Faz A): Project = construction projesini baştan sona temsil eder ──
// (ham fırsattan won'a). Kaynak-bağımsız: source + externalRef ile manuel,
// Barbour veya gelecekteki feed'den girilebilir.
model Project {
  id          String        @id @default(uuid())
  title       String
  description String?
  stage       ProjectStage  @default(IDENTIFIED)
  source      ProjectSource @default(MANUAL)
  externalRef String? // dış sistem ID'si (Barbour bugün, başka feed yarın)
  importedAt  DateTime?

  // Yapısal proje verisi
  projectCategory   ProjectCategory?
  unitCount         Int? // tahmini büyüklük: oda/key/plot/cover
  value             Decimal?         @db.Decimal(18, 2)
  currency          String           @default("GBP")
  expectedStartDate DateTime?
  // Proje lokasyonu (firmanın şehrinden ayrı)
  siteCity          String?
  siteRegion        String?
  sitePostcode      String?

  probability    Int? // 0-100, ağırlıklı forecast (Faz B)
  lostReasonCode LossReason?
  lostReason     String?
  stageUpdatedAt DateTime    @default(now())

  ownerId String
  owner   User   @relation("project_owner", fields: [ownerId], references: [id])

  companies   ProjectCompany[]
  contacts    ProjectContact[]
  rfqs        Rfq[]
  stageEvents ProjectStageEvent[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalRef]) // dedupe kaynak başına namespace'li
  @@index([stage])
  @@index([ownerId, stage])
  @@index([source])
  @@index([projectCategory])
}

// Aşama değişim geçmişi — velocity + hesap verebilirlik
model ProjectStageEvent {
  id          String        @id @default(uuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStage   ProjectStage?
  toStage     ProjectStage
  changedById String
  changedAt   DateTime      @default(now())
  note        String?

  @@index([projectId, changedAt])
}

// M:N — projede hangi firmalar, hangi rolde
model ProjectCompany {
  id        String          @id @default(uuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId String
  company   CustomerCompany @relation(fields: [companyId], references: [id])
  role      CompanyRole
  isPrimary Boolean         @default(false) // teklif verdiğimiz asıl müşteri

  @@unique([projectId, companyId, role])
  @@index([companyId])
}

// Projede konuştuğumuz spesifik kişiler
model ProjectContact {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])
  note      String?

  @@unique([projectId, contactId])
}

model Comment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id])

  authorId String
  author   User   @relation("comment_author", fields: [authorId], references: [id])

  @@index([rfqId, createdAt])
}

model Notification {
  id           String    @id @default(uuid())
  type         String
  recipientId  String
  recipient    User      @relation("notification_recipient", fields: [recipientId], references: [id])
  rfqId        String?
  rfq          Rfq?      @relation(fields: [rfqId], references: [id])
  subject      String
  body         String
  sentAt       DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([rfqId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  purpose   String    @default("reset") // "reset" | "invite"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}
